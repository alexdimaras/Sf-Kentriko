{
  "name": "sf-kentro",
  "version": "1.3.0",
  "description": "SF Κέντρο — back office για specialforces.gr και stratiotikaeidi.gr",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:win": "pkg . --targets node22-win-x64 --output dist/SF-Kentro.exe --compress GZip",
    "build:linux": "pkg . --targets node22-linux-x64 --output dist/sf-kentro-linux"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.3.0",
    "node-html-parser": "^7.0.1",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@fontsource-variable/commissioner": "^5.2.8",
    "@yao-pkg/pkg": "^6.24.0"
  },
  "bin": "server.js",
  "pkg": {
    "assets": [
      "public/**/*",
      "lib/dict/**/*"
    ],
    "scripts": [
      "lib/**/*.js"
    ]
  },
  "private": true
}
