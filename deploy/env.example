# Αντέγραψε σε ".env" και συμπλήρωσε.
# Η διεύθυνση που θα γράφουν όλοι (ένα subdomain σας, με DNS A record προς τον διακομιστή):
KENTRO_HOST=kentro.specialforces.gr
# Προαιρετικά: ο πρώτος διαχειριστής (αλλιώς ένας κωδικός αρχικής ρύθμισης στο log: docker compose logs kentro)
KENTRO_ADMIN_USER=
KENTRO_ADMIN_PASSWORD=
